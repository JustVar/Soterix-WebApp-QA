# Soterix WebApp QA - copy this file to .env and fill in the two account lines.
# The server, the site and the camera live in config/env/qa.py.

# Which config/env/<ENV>.py to load. Optional, default qa.
ENV=qa
# The account the tests sign in as (config/env/qa.py get_credentials).
QA_USER=
QA_PASSWORD=

# Run switches, one per line, each off unless set. The file that reads it is named.
# STREAM_GUARD=off      # tests/shared/helpers/stream_health.py: run the livestream tests without measuring the camera first
# PREFLIGHT=off         # tests/shared/helpers/preflight.py: skip the one login check before the run
# RUN_ARCHIVE=off       # plugins/run_archive.py: do not copy the run to reports/runs/
# REPORT_SCREENSHOTS=all  # plugins/report_media.py: embed every test's screenshot, not only failures (off disables the plugin)
# RECORD_VIDEO=off      # conftest.py authenticated_page: skip the per-test video
# RUN_GUARD=off         # plugins/single_run_guard.py: allow a second pytest beside a live run (it wipes the first run's evidence)
# TEST_CAMERA=          # tests/shared/helpers/camera_pool.py: drive this camera instead of test_camera_name
# CHROME_ARGS=          # tests/shared/helpers/stream_health.py: extra Chrome flags, for a Linux runner that decodes H.265 through VA-API (docs/LINUX_H265.md)
# TEST_WALL_CAP=        # plugins/wall_clock.py: seconds a single test may run before the run ends it

# QA Touch upload. Optional: nothing uploads without `pytest --qatouch-upload --qatouch-run <key>`.
# QATOUCH_API_KEY=
# QATOUCH_DOMAIN=
# QATOUCH_PROJECT_ID=

# Removed: BOX and the per-box QA_INDIA_* / QA_US_* pairs. There is one server and one account pair.
