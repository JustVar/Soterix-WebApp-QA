# ===========================================
# Soterix QA Automation - Environment Template
# Copy this file to .env and fill in values
# ===========================================

# Environment selection. ENV is the key the code reads (conftest.py,
# config/base_config.py). Values: qa, stage, prod. Aliases accepted:
# staging/uat -> stage, production/demo/user -> prod.
ENV=qa
BOX=us

# Per-box accounts. Only needed when you set BOX=<name> to target a specific
# box instead of the default. Box names live in config/env/{qa,stage,prod}.py.
# QA testing happens mainly on the india box.
QA_INDIA_USER=
QA_INDIA_PASSWORD=
QA_US_USER=
QA_US_PASSWORD=
STAGE_USER=
STAGE_PASSWORD=
# ENV=neurosen (config/env/neurosen.py): the private cloud build in the lab.
# The address is not in git; the env refuses to load without it.
NEUROSEN_BASE_URL=
NEUROSEN_USER=
NEUROSEN_PASSWORD=

# Shared accounts on the production hosts. Passwords only; the addresses are
# in config/env/prod.py.
HARDWARE_LAB_PASSWORD=
TEST_AUTO_PROD_PASSWORD=

# Site that API-built test data goes to (tests/shared/api/). Must be the id
# of the site that test_site_name in config/env/ names. When they differ the
# api fixture skips and its message gives the right id.
TEST_SITE_ID=

# Keep existing content below (Jira, QA Touch, Azure, Slack, etc.)
# Replace placeholders with real values in your local .env (do NOT commit secrets).

# Jira
# JIRA_URL=https://soterixsystems.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=your_jira_api_token_here
# JIRA_PROJECT_KEY=NC


# QA Touch
# API base is always https://api.qatouch.com (do not change)
# QATOUCH_API_KEY=your_qatouch_api_key_here
# QATOUCH_DOMAIN=soterixsystems
# QATOUCH_PROJECT_ID=JlW1
# Public REST API token + short domain. Required by the tools/ QA Touch scripts
# (case migration, step splitting, metadata backfill, audits).
# QATOUCH_API_TOKEN=your_qatouch_rest_api_token_here
# Template run keys used by tools/run_suite.py (each invocation clones into a fresh run)
# Opt-in: switch the result reporter to QA Touch's Playwright endpoint
# (rich payload - execution_time per result + failure screenshots)
# QATOUCH_USE_PLAYWRIGHT_ENDPOINT=1
# Disable failure-screenshot capture even when the Playwright endpoint is on
# (defaults to enabled when QATOUCH_USE_PLAYWRIGHT_ENDPOINT=1)
# QATOUCH_CAPTURE_SCREENSHOTS=0

# Test report emailing (tools/send_test_report.py + conftest sessionfinish hook)
# SEND_TEST_REPORT=1
# REPORT_RECIPIENT=qa-reports@soterixsystems.com

# Per-run archive (plugins/run_archive.py). After every run it copies the
# report, screenshots, traces, and results JSON to reports/runs/ and keeps
# the newest 20 runs of each target, 100 in total. Start at
# reports/runs/index.html. Set off to disable.
# RUN_ARCHIVE=off
# Screenshot reporter (plugins/report_media.py). Default: capture on, embed
# failures only. Set off to disable the plugin. Set all to also embed
# passed-test screenshots in the HTML report.
# REPORT_SCREENSHOTS=off
# Per-test video (conftest authenticated_page). Default: record every test
# and keep the clip only on failure, as reports/artifacts/<test>-video.webm
# next to the trace. The run archive copies it and links it from run.html.
# Set off to skip the recording.
# RECORD_VIDEO=off
# Single-run guard (plugins/single_run_guard.py). A second pytest run started
# while one is active would silently corrupt the first run's report.html,
# screenshots, and traces - the guard refuses to start it instead. The lock
# file (logs/.run_lock_<env>.json) is the same one tools/run_lock.py and
# tools/run_suite.py use. Set off to skip the guard entirely.
# RUN_GUARD=off

# Microsoft Graph OAuth (Email)
# AZURE_TENANT_ID=your_tenant_id
# AZURE_CLIENT_ID=your_client_id
# AZURE_CLIENT_SECRET=your_client_secret
# AZURE_SECRET_EXPIRES=2026-07-22
# EMAIL_FROM=qa-reports@soterixsystems.com
# EMAIL_TO=you@example.com

# Slack webhook / alert channel
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX
# SLACK_ALERT_CHANNEL=#qa-automation

# QA credentials (per-user)
# QA_USER=your_email@soterixsystems.com
# QA_PASSWORD=your_password
# Jira Configuration (copy to .env.local and fill with real values)
JIRA_URL=https://soterixsystems.atlassian.net
JIRA_EMAIL=your_email@soterixsystems.com
JIRA_API_TOKEN=your_token_here
JIRA_PROJECT_KEY=NC

BUG_CREATION_ENABLED=false

# SMTP (optional) for review queue emails
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_FROM=qa-reports@soterixsystems.com
SMTP_USER=
SMTP_PASSWORD=

# QA Operations Hub Dashboard (tools/qa_dashboard)


# QA Ops Hub - API Key (for CLI -> web app queue submissions)
# QA_OPS_API_KEY=your_shared_secret_here

# QA Ops Hub - API URL (dev machine points to NUC)
# QA_OPS_API_URL=http://192.168.1.174/qa-ops


# ===========================================
# QA Environment Credentials
# Each tester sets their own credentials
# ===========================================
# Your QA login (required)
# QA_USER=your_email@soterixsystems.com
# QA_PASSWORD=your_password

# Automation accounts (Admin), for reference:
# - Prod: test-auto-prod@soterixsystems.com
# - QA production box: hardware-lab@soterixsystems.com

# ===========================================
# Optional keys the code reads (leave unset for the defaults)
# ===========================================
# BUG_CREATION_ENABLED=false  # tools/run_suite.py --file-bugs refuses unless this is true
# APP_TYPE=                # config/base_config.py: product flavour override
# BASE_URL=                # tests/shared/pages/login_page.py, tools/pre_run_check.py: target URL override
# EXPECTED_LANDING=        # conftest.py: path the login must land on (default per env)
# C2C_CAMERA_IP=           # tests/c2c: single-camera mode (skips the YAML)
# C2C_CAMERA_USER=root     # tests/c2c, tools/discover_c2c_cameras.py
# C2C_CAMERA_PASS=         # required for the c2c suite; no default
# C2C_NAV_TIMEOUT=         # tests/c2c/conftest.py: camera UI navigation timeout (ms)
# QATOUCH_UPLOAD=1         # plugins/qatouch_reporter.py: upload without --qatouch-upload
# QATOUCH_RUN_KEY=         # plugins/qatouch_reporter.py: alternative to --qatouch-run
# QATOUCH_ASSIGN_TO=       # tools/run_suite.py: assignee for created runs
# QATOUCH_MILESTONE_KEY=   # tools/run_suite.py: milestone for created runs
# SMTP_USE_TLS=1           # tools/test_smtp.py
