# Headless Weston for the QA nightly on spartan1 (deploy/spartan1/README.md).
#
# Why it exists: the tenants stream H.265, and Chrome on Linux decodes it
# only through the GPU's VA-API decoder, and only on its Wayland backend
# (every other backend loses the GPU process on the first decoded frame,
# measured 09/17/2026). This is that Wayland display: no monitor, no seat,
# a GL renderer on the Intel graphics, one socket the nightly looks for at
# /run/qa-weston/wl-qa. Installed at /etc/systemd/system/qa-weston.service.
[Unit]
Description=Headless Weston display for the QA nightly (Chrome H.265 decoding)
After=multi-user.target

[Service]
User=soterix
Group=soterix
# RuntimeDirectory creates /run/qa-weston (mode 0700, owned by soterix), the
# XDG_RUNTIME_DIR Weston puts its socket in; the nightly reads the same path.
RuntimeDirectory=qa-weston
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/qa-weston
# GLVND would offer the NVIDIA EGL first; Mesa's picks the Intel render node.
Environment=__EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json
# --idle-time=0: an idle display switches its output off and stops presenting.
ExecStart=/usr/bin/weston --backend=headless --renderer=gl --socket=wl-qa --idle-time=0 --width=1600 --height=900
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
