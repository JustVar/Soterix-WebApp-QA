#!/bin/sh
# The collect gate, before the commit exists. CI (.github/workflows/
# collect-gate.yml) runs the same checks on every push. This hook runs
# them first, on the laptop, cheapest first, so a commit that would fail
# the gate fails here.
#
# Install, once per clone: git config core.hooksPath tools/hooks
# (README > Day one). Bypass only for a genuine emergency:
# git commit --no-verify.
#
# What each check is for:
# - secret_check: no staged line may carry a credential value from .env.
#   A camera login once reached two GitHub organisations through a
#   QA Touch backup file that was committed.
# - convention_check: the house conventions, on the lines this commit
#   adds. HIGH findings block. MEDIUM findings print and pass (justify
#   them in the commit message).
# - test_inventory --check: docs/TEST_INVENTORY.md must match the tests
#   on disk. Regenerate it with: python tools/test_inventory.py
# - ruff: the Python style rules in pyproject.toml. A literal
#   non-breaking space fails CI when nobody lints locally.
# - collect_floor: the whole repo and the offline suites still collect
#   and no suite shrank. A broken import fails here, not on main. Its
#   collect-only pytest writes its html to logs/ (PYTEST_ADDOPTS). Without
#   that it replaces reports/report.html with an empty shell on every commit.
# - the offline suites: the pins for the plugins, tools and helpers. The
#   run changes nothing a live UI run writes: the archive, run record,
#   run guard and screenshots are off, and its html report goes to
#   logs/hook_report.html instead of reports/report.html.
#
# Ten to thirty seconds in all, most of it the last two.
#
# The interpreter: the repo's venv on Windows, then the venv on Linux or
# macOS, then the python3 on PATH.
if [ -x venv/Scripts/python.exe ]; then
    py=venv/Scripts/python.exe
elif [ -x venv/bin/python ]; then
    py=venv/bin/python
elif command -v python3 >/dev/null 2>&1; then
    py=python3
else
    echo "pre-commit: no venv found. Create one: python -m venv venv, then pip install -r requirements.txt" >&2
    exit 1
fi
$py tools/secret_check.py || exit 1
$py tools/convention_check.py || exit 1
$py tools/test_inventory.py --check || exit 1
$py -m ruff check . || exit 1
PYTEST_ADDOPTS="--html=logs/hook_collect.html -p no:cacheprovider" $py tools/collect_floor.py || exit 1
RUN_ARCHIVE=off RUN_GUARD=off REPORT_SCREENSHOTS=off $py -m pytest tests/plugins tests/tools tests/helpers -p no:cacheprovider --no-run-record --html=logs/hook_report.html || exit 1
