#!/bin/sh
# Attribution gate: nothing this repo commits names an AI tool, model or
# co-author. The rule is in AGENTS.md ("Hard rules") and docs/CI.md, and
# it is absolute - commit messages describe what the code change does,
# not how it was produced.
#
# This hook exists because a rule that depends on remembering is a rule
# that fails. This one fails the commit instead.
#
# A co-author line is matched only when it names an AI vendor or model:
# dependabot and other real bots co-author legitimately, and four such
# lines already sit in this history.
#
# Install, once per clone: git config core.hooksPath tools/hooks
# (README > Day one). CI runs this same file on every commit a push
# brings (.github/workflows/collect-gate.yml), so a commit made without
# the hook meets it there. Bypass only for a genuine emergency:
# git commit --no-verify.
msg_file="$1"

# Strip comment lines - git's own template mentions nothing we match,
# but a reviewer's quoted text should not trip the gate.
body=$(grep -v '^#' "$msg_file")

if printf '%s' "$body" | grep -qiE \
    'co-authored-by:.*(anthropic|claude|copilot|gpt|gemini)|generated with \[?claude|claude code|anthropic|noreply@anthropic|🤖'
then
    echo "commit-msg: this message names an AI tool, model or co-author."
    echo ""
    printf '%s' "$body" | grep -inE \
        'co-authored-by:.*(anthropic|claude|copilot|gpt|gemini)|generated with \[?claude|claude code|anthropic|noreply@anthropic|🤖' \
        | sed 's/^/    /'
    echo ""
    echo "House rule (AGENTS.md > Hard rules, docs/CI.md): commit messages"
    echo "and PR bodies describe WHAT THE CODE CHANGE DOES, never how they"
    echo "were produced. They name no AI tool, no model and no co-author."
    echo "Rewrite the message and commit again."
    exit 1
fi
exit 0
