# Ignore virtual environments
venv/

# Ignore Python cache
__pycache__/
*.py[cod]

# Ignore environment files
.env
.env.*
!/.env.template

# Ignore VS Code settings
.vscode/

# Ignore logs and reports
*.log
*.html
report/
report.html

# Ignore OS junk
.DS_Store
Thumbs.db

# Ignore cached session token used by tests
.session_cache
